{
  "compilerOptions": {
    "outDir": "./dist",
    "module": "esnext",
    "target": "esnext",
    "strict": true,
    // 允许 this 有隐式的 any 类型
    "noImplicitThis": false,
    "declaration": true,
    "noEmit": true,
    // todo f
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    // todo f
    // "sourceMap": true,
    "jsx": "react",
    "allowSyntheticDefaultImports": true,
    "baseUrl": "./",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "moduleResolution": "node"
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "./src/**/*"
  ]
}
